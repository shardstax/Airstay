# Copy this to the repository root as .env on the VPS and restrict it to the deploy user.
AIRSTAY_HOST=your-demo-host.duckdns.org
# Optional previous hostname to redirect to AIRSTAY_HOST. Keep its DNS record pointing at this VPS.
AIRSTAY_LEGACY_HOST=
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
OPENAI_API_KEY=
AI_SEARCH_DAILY_REQUEST_LIMIT=200
DEMO_SEED_ON_STARTUP=true
# Stripe test checkout is configured once the public hostname is available.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
