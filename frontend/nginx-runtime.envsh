#!/bin/sh
# Sourced by the official image before it renders the Nginx template.
export AIRSTAY_API_UPSTREAM="${AIRSTAY_API_UPSTREAM:-http://app:8080}"
export AIRSTAY_FORWARDED_PROTO="${AIRSTAY_FORWARDED_PROTO:-\$scheme}"
export AIRSTAY_DNS_RESOLVERS="${AIRSTAY_DNS_RESOLVERS:-$(awk '/^nameserver[[:space:]]+/ {
    address = $2
    if (address ~ /:/) address = "[" address "]"
    printf "%s%s", separator, address
    separator = " "
}' /etc/resolv.conf)}"
export NGINX_ENVSUBST_FILTER='^AIRSTAY_(API_UPSTREAM|FORWARDED_PROTO|DNS_RESOLVERS)$'
