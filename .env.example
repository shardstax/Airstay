# Copy to .env (git-ignored) and fill in. Spring reads these as environment variables.
#
# TWO WAYS TO USE THIS FILE
#  1. docker compose up (recommended): Compose reads .env only to fill ${...} placeholders in docker-compose.yml and
#     sets the database, Redis, Kafka and SMTP addresses itself (the container names). So for Docker you only need:
#       STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, JWT_SECRET_KEY, POSTGRES_PASSWORD (optional),
#       FRONTEND_URL, CORS_ALLOWED_ORIGINS, and the switches (SEARCH_CACHE_ENABLED, RATE_LIMIT_ENABLED, PAYMENTS_FAKE).
#     Other lines below are ignored by Docker: the compose file does not pass them to the app.
#  2. Running the app yourself (./mvnw spring-boot:run): export every variable below (localhost addresses), because
#     nothing fills in the defaults for you.
# Use Stripe SANDBOX (test mode) keys only, and never commit .env.

# PostgreSQL 16+ (empty database; Flyway creates the schema on first start)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/airstay
SPRING_DATASOURCE_USERNAME=airstay
SPRING_DATASOURCE_PASSWORD=change-me

# HMAC key for JWTs: at least 32 characters (256 bits)
JWT_SECRET_KEY=replace-with-a-random-string-of-at-least-32-chars

# Stripe test-mode keys (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen --forward-to localhost:8080/api/v1/webhook/payment`
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Redis (optional accelerator: search cache and rate limiting). If it is down the app keeps working from PostgreSQL.
# docker compose starts one for you and sets REDIS_HOST=redis.
REDIS_HOST=localhost
REDIS_PORT=6379
# Switches (default: on)
# SEARCH_CACHE_ENABLED=false
# RATE_LIMIT_ENABLED=false

# Kafka: booking events (docs/events.md) and refund requests. docker compose starts one and sets
# KAFKA_BOOTSTRAP_SERVERS=kafka:9092. Bookings never depend on it: every event is saved in the PostgreSQL outbox table in the
# booking's own transaction and published when Kafka is reachable.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Stops the outbox relay and the refund worker; events keep waiting in the outbox table until switched on again.
# EVENTS_ENABLED=false

# Notification service (notification-service/, a separate deployable): reads events from Kafka and e-mails the guest.
# docker compose starts Mailpit, a fake mail server whose inbox is at http://localhost:8025, and sets SMTP_HOST=mailpit.
# SMTP_HOST=localhost
# SMTP_PORT=1025

# Frontend origin (Vite dev server by default)
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Refresh-token cookie. Browsers accept Secure cookies on http://localhost.
REFRESH_COOKIE_SECURE=true
# Strict when frontend and API share a site; use None (with Secure=true) when they are on different domains
REFRESH_COOKIE_SAME_SITE=Strict

# Optional: comma-separated ISO dates that get holiday pricing
# PRICING_HOLIDAYS=2026-12-25,2027-01-01
